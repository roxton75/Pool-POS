{
  "expo": {
    "name": "Q-Zone POS",
    "slug": "qzone-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/enhanced-op.png",
    "scheme": "qzonemanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logos/enhanced-op.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/logos/enhanced-op.png",
        "monochromeImage": "./assets/logos/solid-op.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rudrx75.qzonemanager"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logos/enhanced-op.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/logos/enhanced-op.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
