{
  "expo": {
    "name": "Q-Zone POS",
    "slug": "qzone-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/enhanced-op.avif",
    "scheme": "qzonemanager",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logos/enhanced-op.avif"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logos/enhanced-op.avif",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logos/enhanced-op.avif"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/logos/enhanced-op.avif",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
